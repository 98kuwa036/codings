{
  "name": "dual-mode-claude-ui",
  "version": "1.0.0",
  "description": "Dual-mode Claude Code UI: Claude Code mode + PCT 100 LLM Orchestration mode",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "install:cli": "npm install -g @anthropic-ai/claude-code"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "node-pty": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "http-proxy": "^1.18.1",
    "chokidar": "^3.6.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
