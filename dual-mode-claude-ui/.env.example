# Server Configuration
PORT=4000
NODE_ENV=development

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
UI_PASSWORD=your-ui-password

# Claude CLI Authentication
# Primary: Claude Pro subscription (claude auth login)
# Fallback: Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PCT 100 Orchestration System (Bushidan Multi-Agent)
ORCHESTRATION_HOST=192.168.1.100
ORCHESTRATION_PORT=8067
ORCHESTRATION_PASSWORD=your-bushidan-password

# Feature Flags
ENABLE_SHELL=true
ENABLE_FILE_EXPLORER=true
PLATFORM_MODE=false
