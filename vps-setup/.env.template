# ─────────────────────────────────────────────────────────────────
# Immich + rclone environment configuration
# Copy this file to .env and fill in all values
# ─────────────────────────────────────────────────────────────────

# ── Immich ──────────────────────────────────────────────────────

# Immich version (use "release" for latest stable)
IMMICH_VERSION=release

# Path on the VPS where Immich stores uploaded photos and thumbnails
# This should be on a large disk (NOT the rclone mount)
UPLOAD_LOCATION=/var/lib/immich/upload

# Immich API access
# Get from: Immich Web UI → Account Settings → API Keys → New API Key
IMMICH_URL=http://immich-server:3001
IMMICH_API_KEY=your_immich_api_key_here

# External library ID
# Get from: Immich Web UI → Administration → External Libraries → (click library) → ID in URL
IMMICH_LIBRARY_ID=your_library_id_here

# ── Database ────────────────────────────────────────────────────

DB_HOSTNAME=database
DB_USERNAME=immich
DB_PASSWORD=change_me_strong_password_here
DB_DATABASE_NAME=immich
DB_PORT=5432

# Required by Immich internals
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOSTNAME}:${DB_PORT}/${DB_DATABASE_NAME}

# ── Redis ────────────────────────────────────────────────────────

REDIS_HOSTNAME=redis

# ── rclone / OneDrive ────────────────────────────────────────────

# OneDrive path to mount as Immich external library
# This should match the --dst-folder used in the GitHub Actions workflow
ONEDRIVE_IMMICH_PATH=Photos/Immich

# ── Auto-rescan ──────────────────────────────────────────────────

# Directory to watch for new files (matches rclone mount point)
WATCH_PATH=/mnt/onedrive

# Seconds to wait after last file change before triggering scan
DEBOUNCE_SECONDS=60

# ── Machine Learning ─────────────────────────────────────────────

# Immich built-in AI (face recognition + CLIP semantic search)
# Set to true to enable; requires more RAM/CPU
IMMICH_MACHINE_LEARNING_ENABLED=true
